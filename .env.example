JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_EMAIL=you@example.com
JIRA_API_TOKEN=your_api_token

LISTEN_ADDR=:8080
DASH_TZ=Europe/Rome
MAX_RANGE_DAYS=90
WORKLOG_CONCURRENCY=8
# Recommended: set to a single project key for faster queries and to enable board list.
FIXED_PROJECT_KEY=

# Optional: protect with basic auth (use if exposing outside LAN)
#DASH_BASIC_AUTH_USER=admin
#DASH_BASIC_AUTH_PASS=change-me
